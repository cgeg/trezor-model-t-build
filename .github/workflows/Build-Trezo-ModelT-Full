name: Build Trezor Model T Full Suite (Non-Production)

'on':
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Trezor Firmware
        uses: actions/checkout@v4
        with:
          repository: trezor/trezor-firmware
          ref: main
          submodules: recursive

      - name: Ensure Submodules
        run: git submodule update --init --recursive --force

      - name: Install Nix
        uses: cachix/install-nix-action@v31

      - name: Build Boardloader, Bootloader & Firmware (Non-Production)
        run: |
          nix-shell --run "
            export PRODUCTION=0
            uv run xtask build boardloader -m t2t1
            uv run xtask build bootloader -m t2t1
            uv run xtask build firmware -m t2t1
          "

      - name: Collect & Verify All Binaries
        run: |
          mkdir -p dist/boardloader dist/bootloader dist/firmware
          find core/build* -type f -name 'boardloader-T2T1*.bin' -exec cp {} dist/boardloader/ \;
          find core/build* -type f -name 'bootloader-T2T1*.bin' -exec cp {} dist/bootloader/ \;
          find core/build* -type f -name 'trezor-T2T1*.bin' -exec cp {} dist/firmware/ \;
          echo "=== 產出的所有非生產模式檔案 ==="
          ls -lhR dist/

      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: trezor-model-t-dev-suite
          path: dist/
          if-no-files-found: error
          retention-days: 14

